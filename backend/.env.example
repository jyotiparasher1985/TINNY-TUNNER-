# Django settings — local development
# Copy to `.env` and edit before deploying.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Shared key for the read-only admissions dashboard API (frontend /admin page)
ADMIN_API_KEY=change-me-too

# Comma separated list of origins allowed to call the JSON API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173